# Local environment variables — copy this file to .env.development and fill in real values.
# .env.* files are gitignored — never commit real URLs or tokens.
# The site itself needs none of these to run or build: every page reads committed data.
# (The Contribute form link is not a secret: it lives in content/pages/abl-contribute.yaml → formUrl.)

# Pramaan Library (Resource Centre Sheet) — only for running `npm run content:sync-pramaan-library` locally.
# Values come from docs/PRAMAAN-LIBRARY-SETUP-GUIDE.md Steps 3 and 5. Never commit real values.
PRAMAAN_LIBRARY_API_URL=https://script.google.com/macros/s/.../exec
PRAMAAN_LIBRARY_SYNC_TOKEN=

# Publications ("TIDE THRIvE Publications (Responses)" Sheet) — only for running
# `npm run content:sync-publications` locally. Values: docs/PUBLICATIONS-SETUP-GUIDE.md. Never commit real values.
PUBLICATIONS_API_URL=https://script.google.com/macros/s/.../exec
PUBLICATIONS_SYNC_TOKEN=

# Partners ("TIDE/THRIvE Partners (Responses)" Sheet) — only for running `npm run content:sync-partners` locally.
# Values: docs/PARTNERS-SETUP-GUIDE.md. Never commit real values.
PARTNERS_API_URL=https://script.google.com/macros/s/.../exec
PARTNERS_SYNC_TOKEN=

# Social Changemakers (Past SCF Sheet) — only for running `npm run content:sync-social-changemakers` locally.
# Values: docs/SOCIAL-CHANGEMAKERS-SETUP-GUIDE.md. Never commit real values.
SOCIAL_CHANGEMAKERS_API_URL=https://script.google.com/macros/s/.../exec
SOCIAL_CHANGEMAKERS_SYNC_TOKEN=
