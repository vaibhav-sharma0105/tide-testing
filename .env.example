# ABL Resource Library — environment variables
# Copy this file to .env.development (local) or .env.production (prod deploy)
# and fill in real values. These files are gitignored — never commit real URLs.

# Apps Script Web App URL (from Extensions → Apps Script → Deploy → Web App)
VITE_ABL_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Form URL for the Contribute a Resource form
VITE_ABL_CONTRIBUTE_FORM_URL=https://forms.gle/YOUR_FORM_ID
