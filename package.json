{
  "name": "tide-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/yaml-to-json.js",
    "dev": "vite",
    "prebuild": "node scripts/yaml-to-json.js",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "content:sync": "node scripts/yaml-to-json.js",
    "content:validate": "node scripts/validate-content.js",
    "content:bootstrap": "node scripts/bootstrap-yaml.js",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:ui": "vitest --ui --config vitest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:site": "playwright test -c playwright.site.config.js --project=chromium --grep-invert @matrix",
    "test:e2e:full": "playwright test -c playwright.site.config.js --project=chromium --project=firefox --project=webkit",
    "test:e2e:visual": "playwright test -c playwright.site.config.js --project=visual",
    "check:dist": "node scripts/check-dist.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "content:sync-pramaan-library": "node scripts/sync-pramaan-library.js",
    "content:sync-publications": "node scripts/sync-publications.js",
    "content:sync-partners": "node scripts/sync-partners.js",
    "content:sync-social-changemakers": "node scripts/sync-social-changemakers.js"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.0.1",
    "vitest": "^5.1.1"
  }
}
